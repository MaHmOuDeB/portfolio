{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "sources:sync": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/sync-sources.ts",
    "prebuild": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/gen-obf-constants.ts --check && npm run sources:sync -- --check",
    "build": "next build",
    "truth:audit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/truth-audit.ts",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "lint:css": "stylelint \"src/**/*.css\"",
    "pretest": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/gen-obf-constants.ts --check && npm run sources:sync -- --check",
    "test": "vitest run",
    "pretest:cov": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/gen-obf-constants.ts --check && npm run sources:sync -- --check",
    "test:cov": "vitest run --coverage",
    "test:e2e": "playwright test",
    "gen:obf": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/gen-obf-constants.ts",
    "build:meta": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-meta.ts",
    "lhci": "lhci autorun",
    "links": "lychee --config .lychee.toml http://localhost:3123/",
    "check": "npm run typecheck && npm run lint && npm run lint:css && npm run test"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.3",
    "ajv": "8.20.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "fast-check": "4.10.2",
    "parse5": "8.0.1",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vercel": "62.2.0",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=24.2 <25"
  }
}
