# Environment contract. Copy to .env.local for local work. Never commit real values.
# Every variable below is read in src/lib/env.ts and is optional there, so a build with an empty environment passes.

# Vercel Production only, never Preview
KV_REST_API_URL=
# Vercel Production only, never Preview
KV_REST_API_TOKEN=
# Vercel Production only, never Preview
KV_REST_API_READ_ONLY_TOKEN=
# Vercel Production only, never Preview
GLOBAL_CONFIG=
# Vercel Production only, never Preview
INTERNAL_TRAFFIC_SECRET=
# Vercel Production only, never Preview. At least 32 characters or it is treated as unset:
# generate with `openssl rand -base64 32`
EXCLUDE_TOKEN=
# Vercel Production only, never Preview
RATELIMIT_HMAC_KEY=
# Vercel Production only, never Preview: the contact form's Resend API key
RESEND_API_KEY=
# Vercel Production only, never Preview: the inbox the contact form delivers to
CONTACT_TO_EMAIL=
# Playwright only: the loopback fake of Resend's endpoint; ignored in production and for any other host
RESEND_API_URL=
# set automatically by Vercel (1 on Vercel)
VERCEL=
# set automatically by Vercel
VERCEL_ENV=
# set automatically by Vercel
VERCEL_PROJECT_PRODUCTION_URL=
# set automatically by Vercel
VERCEL_URL=
# set automatically by Vercel
VERCEL_GIT_COMMIT_SHA=
# set automatically by `next build` (phase-production-build); never set it by hand
NEXT_PHASE=
# Playwright only: allows writes to a loopback fake store; ignored in production
EXPERIMENT_FAKE_STORE=
# Playwright only: milliseconds added to the server clock, honoured only with the loopback fake store
# outside production (never on Vercel)
EXPERIMENT_CLOCK_OFFSET_MS=
# Not production: a bare hostname for the canonical origin of a preview, local or CI build (default
# canonical.invalid). A production build refuses it and uses VERCEL_PROJECT_PRODUCTION_URL.
SEO_TEST_ORIGIN_HOST=

# GitHub Actions secrets (repository settings, not read by the app):
# VERCEL_TOKEN
# VERCEL_ORG_ID
# VERCEL_PROJECT_ID
# VERCEL_AUTOMATION_BYPASS_SECRET
# INTERNAL_TRAFFIC_SECRET
# TRUTH_DENYLIST
